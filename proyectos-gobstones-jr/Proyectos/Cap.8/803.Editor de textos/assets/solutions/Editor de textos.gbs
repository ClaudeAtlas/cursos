    PonerElCarácter(códigoDeLaLetraM())
  }
  on K_N {
    PonerElCarácter(códigoDeLaLetraN())
  }
  K_Ñ -> {
    PonerElCarácter(códigoDeLaLetraÑ())
  }
  on K_O {
    PonerElCarácter(códigoDeLaLetraO())
  }
  on K_P {
    PonerElCarácter(códigoDeLaLetraP())
  }
  on K_Q {
    PonerElCarácter(códigoDeLaLetraQ())
  }
  on K_R {
    PonerElCarácter(códigoDeLaLetraR())
  }
  on K_S {
    PonerElCarácter(códigoDeLaLetraS())
  }
  on K_T {
    PonerElCarácter(códigoDeLaLetraT())
  }
  on K_U {
    PonerElCarácter(códigoDeLaLetraU())
  }
  on K_V {
    PonerElCarácter(códigoDeLaLetraV())
  }
  on K_W {
    PonerElCarácter(códigoDeLaLetraW())
  }
  on K_X {
    PonerElCarácter(códigoDeLaLetraX())
  }
  on K_Y {
    PonerElCarácter(códigoDeLaLetraY())
  }
  on K_Z {
    PonerElCarácter(códigoDeLaLetraZ())
  }
}
