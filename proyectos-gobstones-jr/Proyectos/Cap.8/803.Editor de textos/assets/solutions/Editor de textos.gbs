function códigoDeLaLetraZ() {
  return (27)
}


interactive program {
  on K_LEFT {
    MoverSiSePuede(Oeste)
  }
  on K_RIGHT {
    MoverSiSePuede(Este)
  }
  on K_UP {
    MoverSiSePuede(Norte)
  }
  on K_DOWN {
    MoverSiSePuede(Sur)
  }
  on K_RETURN {
    NuevaLínea()
  }
  on K_SPACE {
    PonerElCarácter(códigoDelEspacio())
  }
  on K_A {
    PonerElCarácter(códigoDeLaLetraA())
  }
  on K_B {
    PonerElCarácter(códigoDeLaLetraB())
  }
  on K_C {
    PonerElCarácter(códigoDeLaLetraC())
  }
  on K_D {
    PonerElCarácter(códigoDeLaLetraD())
  }
