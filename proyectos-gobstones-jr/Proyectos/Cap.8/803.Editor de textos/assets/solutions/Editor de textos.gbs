procedure PonerElCarácter(códigoDelCarácter) {
  LimpiarLaCelda()
  Poner_BolitasNegras(códigoDelCarácter)
  AvanzarElCursor()
}

procedure AvanzarElCursor() {
  if (puedeMover(Este)) {
    Mover(Este)
  } else {
    NuevaLínea()
  }
}

procedure NuevaLínea() {
  MoverSiSePuede(Sur)
  IrAlBorde(Oeste)
}

procedure LimpiarLaCelda() {
  SacarTodasLasBolitasNegras()
}

function códigoDelEspacio() {
  return (0)
}

function códigoDeLaLetraA() {
  return (1)
}

procedure MoverSiSePuede(dirección) {
  if (puedeMover(dirección)) {
    Mover(dirección)
  }
}

function códigoDeLaLetraB() {
  return (2)
}

function códigoDeLaLetraC() {
  return (3)
}

function códigoDeLaLetraD() {
  return (4)
}

